{
  "name": "aurealize-cards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "start": "NODE_ENV=production bun src/server/index.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/static": "^1.3.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@tanstack/vue-table": "^8.21.3",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vueuse/motion": "^3.0.3",
    "concurrently": "^9.2.1",
    "elysia": "^1.4.16",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "resend": "^6.6.0",
    "vite": "^7.3.0",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.1.8"
  }
}
